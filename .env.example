# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NVIDIA NIM API key for the B3 VLM adjudicator.
# Get one at https://build.nvidia.com -> any model page -> "Get API Key".
# The code reads this from the environment only; it never reads .env directly,
# so export it in your shell or use a loader such as `set -a; . ./.env; set +a`.
NIM_API_KEY=

# Which model to call. NOT optional in practice: nim.py's built-in default
# (nvidia/nemotron-nano-12b-v2-vl) was retired by NVIDIA on 2026-08-26 and
# returns HTTP 410 Gone. Set this explicitly or every VLM call will fail.
NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional. Defaults to https://integrate.api.nvidia.com/v1
# NIM_BASE_URL=
